{
  "name": "@sebastian-prokesch/freelens-argo-extension",
  "version": "0.1.20",
  "description": "Freelens Extension for Argo resources",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sebastian-Prokesch/freelens-argocd-extension.git",
    "directory": "."
  },
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">= 24.0.0",
    "freelens": "^2.0.0"
  },
  "copyright": "© 2026 Freelens Authors & Sebastian Prokesch",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Freelens Authors & Sebastian Prokesch"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "biome": "pnpm dlx @biomejs/biome@2.1.2",
    "biome:check": "pnpm biome check",
    "biome:fix": "pnpm biome check --fix",
    "biome:migrate": "pnpm biome migrate --write",
    "prettier": "pnpm dlx prettier@3.6.2",
    "prettier:check": "pnpm prettier --check .",
    "prettier:fix": "pnpm prettier --write .",
    "trunk": "pnpm dlx @trunkio/launcher@1.3.4",
    "trunk:check": "pnpm trunk check",
    "trunk:fix": "pnpm trunk check --fix",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm \"/^(biome|prettier):check$/\"",
    "lint:fix": "pnpm \"/^(biome|prettier):fix$/\"",
    "knip": "pnpm dlx knip@6.41.0 --dependencies",
    "knip:check": "pnpm \"/^knip:(development|production)$/\"",
    "knip:development": "pnpm knip",
    "knip:production": "pnpm knip --production --strict",
    "type:check": "pnpm type:check:sources && pnpm type:check:tests && pnpm type:check:tooling && pnpm type:check:integration && pnpm type:check:environments",
    "type:check:sources": "tsc -p src/main && tsc -p src/renderer",
    "type:check:tests": "tsc -p src/tsconfig.json",
    "type:check:tooling": "tsc -p tsconfig.json",
    "type:check:integration": "tsc -p integration",
    "type:check:environments": "tsc -p environment-tests/tsconfig.main.json && tsc -p environment-tests/tsconfig.renderer.json && tsc -p environment-tests",
    "build": "vite build && vite build --mode main",
    "dev": "pnpm \"/^dev:(renderer|main)$/\"",
    "dev:main": "vite build --watch --mode main",
    "dev:renderer": "vite build --watch --no-emptyOutDir",
    "bump-version": "pnpm version --no-commit-hooks --no-git-checks --no-git-tag-version",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "pnpm clean:dist",
    "clean:dts": "pnpm dlx shx@0.4.0 rm -f \"src/**/*.d.scss.ts\"",
    "clean:node_modules": "pnpm dlx shx@0.4.0 rm -rf node_modules",
    "clean:dist": "pnpm dlx shx@0.4.0 rm -rf dist",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\"",
    "clean:all": "pnpm \"/^clean:(dts|node_modules|dist|tgz)$/\"",
    "postupdate": "pnpm biome:migrate"
  },
  "devDependencies": {
    "@freelensapp/extensions": "2.0.0",
    "@kubernetes-models/argo-cd": "^2.7.2",
    "@kubernetes-models/argo-rollouts": "^1.0.1",
    "@kubernetes-models/argo-workflows": "^1.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "playwright": "^1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass-embedded": "1.105.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens",
    "argo",
    "argocd"
  ],
  "packageManager": "pnpm@11.15.1",
  "dependencies": {
    "hpagent": "1.2.0"
  }
}
